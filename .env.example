# =========================================================================
# Plantilla de variables de entorno.
# Copia este archivo a `.env` y rellena los valores reales.
# NUNCA versiones tu .env (está en .gitignore).
# =========================================================================

# ----- App -----
PROJECT_NAME="Sistema Inventario TI"
ENVIRONMENT=development          # development | staging | production
DEBUG=false
LOG_LEVEL=INFO

# ----- Database -----
DB_ENGINE=sqlite
# En despliegues PostgreSQL, DB_WRITE_HOST debe ser un endpoint estable
# (proxy/VIP/DNS de HA), no necesariamente el nombre del contenedor primario.
DB_WRITE_HOST=
DB_READ_HOST=
DB_WRITE_DSN=
DB_READ_DSN=
# Para desarrollo local con SQLite:
POSTGRES_SERVER=sqlite
# Para Postgres:
# POSTGRES_SERVER=db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=inventario
POSTGRES_PORT=5432
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_RECYCLE=1800
DB_ECHO=false

# Replica opcional para reporterÃ­a/exports. Si POSTGRES_REPLICA_SERVER queda
# vacÃ­o, esas lecturas usan el primario en transacciÃ³n READ ONLY.
POSTGRES_REPLICA_SERVER=
POSTGRES_REPLICA_USER=
POSTGRES_REPLICA_PASSWORD=
POSTGRES_REPLICA_DB=
POSTGRES_REPLICA_PORT=5432
DB_READ_POOL_SIZE=10
DB_READ_MAX_OVERFLOW=20
DB_CONNECT_TIMEOUT_SECONDS=5
DB_FAILOVER_PROBE_RETRIES=1
DB_FAILOVER_RETRY_DELAY_SECONDS=0.25
DB_REPLICA_CHECK_TIMEOUT_SECONDS=2
DB_REPLICA_LAG_WARNING_SECONDS=5
DB_REPLICA_LAG_CRITICAL_SECONDS=30

# ----- Storage (local en desarrollo; s3 para MinIO/AWS) -----
STORAGE_BACKEND=local
UPLOAD_DIR=./uploads
MAX_UPLOAD_SIZE_MB=10
S3_ENDPOINT_URL=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=lombardi-adjuntos
S3_REGION=us-east-1
STORAGE_TIMEOUT_SECONDS=5

# ----- Auth -----
# Generar con: openssl rand -hex 32
SECRET_KEY=REEMPLAZAR_CON_openssl_rand_hex_32
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=1

# ----- SSO / OIDC -----
SSO_ENABLED=false
SSO_ALLOWED_EMAIL_DOMAINS=
FRONTEND_BASE_URL=http://localhost:5173
SSO_MICROSOFT_CLIENT_ID=
SSO_MICROSOFT_CLIENT_SECRET=
SSO_MICROSOFT_TENANT=organizations
SSO_MICROSOFT_REDIRECT_URI=http://localhost:8000/api/v1/login/sso/microsoft/callback
SSO_GOOGLE_CLIENT_ID=
SSO_GOOGLE_CLIENT_SECRET=
SSO_GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/login/sso/google/callback

# ----- Security -----
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
RATE_LIMIT_LOGIN=5/minute
RATE_LIMIT_DEFAULT=100/minute
PAGINATION_MAX_LIMIT=200

# ----- Field Encryption (para LIC_Clave_Activacion) -----
# Generar con: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
FIELD_ENCRYPTION_KEY=

# --- Active Directory (opcional; ver DEPLOYMENT.md §4.1) ---
AD_ENABLED=false
AD_SERVER=
AD_START_TLS=false
AD_CA_CERT_FILE=
AD_BIND_USER=
AD_BIND_PASSWORD=
AD_BASE_DN=
AD_ADMIN_GROUP=
AD_SYNC_INTERVAL_MINUTES=0

# --- Sesiones y cola de correos (ver DEPLOYMENT.md §4.2) ---
SESSION_IDLE_TIMEOUT_MINUTES=30
SESSION_ABSOLUTE_MAX_HOURS=12
REFRESH_COOKIE_PERSISTENT=false
REFRESH_REUSE_GRACE_SECONDS=30
OUTBOX_MAX_ATTEMPTS=7
OUTBOX_RETENTION_DAYS=30
